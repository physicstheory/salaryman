#!/bin/sh
# Salary Man AAA gate: every push (Claude, ChatGPT/Codex, anyone) must pass it.
# Installed by: sh Tools/qa/install-hook.sh   (or automatically by `npm install` in Game/)
# Read docs/AAA_GATE.md. Never skip this with --no-verify.
cd "$(git rev-parse --show-toplevel)" || exit 1
z=0000000000000000000000000000000000000000
against=""
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z" ] && continue
  [ "$remote_sha" != "$z" ] && git cat-file -e "$remote_sha" 2>/dev/null && against="$remote_sha"
done
[ -z "$against" ] && against=$(git rev-parse -q --verify origin/claude/friendly-cannon-alnk4v 2>/dev/null)
if ! git diff --quiet HEAD -- Web Engine Tools/qa 2>/dev/null; then
  echo "AAA gate: note, you have uncommitted changes in Web/ Engine/ or Tools/qa; the gate checks the working tree."
fi
allow=""
git log -1 --format=%B | grep -q '\[aaa-loosen-approved\]' && allow="--allow-loosen"
for py in python3 python "py -3"; do
  if $py -c "import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)" >/dev/null 2>&1; then
    exec $py Tools/qa/aaa_gate.py ${against:+--against "$against"} $allow
  fi
done
echo "AAA gate: Python 3 not found. Install Python 3 + 'pip install pillow numpy', then push again."
exit 1
